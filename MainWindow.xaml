<Window x:Class="HistoryBoard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HistoryBoard"
        Title="Доска истории" Width="1420" Height="900" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Background="White" PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp" Deactivated="OnDeactivated" Closing="OnClosing" AllowDrop="True" Drop="OnFileDrop">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="MainHeader" Grid.Row="0" Height="44" Background="#FCFDFB" BorderBrush="#E4E8E0" BorderThickness="0,0,0,1">
      <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="BrandIcon" Source="Assets/brand.png" Width="27" Height="27" Margin="0,0,9,0"/>
          <TextBlock Text="Доска истории" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Width="1" Height="21" Background="#DFE5D9" Margin="16,0"/>
        </StackPanel>
        <TextBox x:Name="LessonTitle" Grid.Column="1" Text="Новый урок" MaxLength="100" MaxWidth="280" HorizontalAlignment="Left" MinWidth="140" FontSize="13" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="Название урока" LostFocus="OnTitleChanged" KeyDown="OnTitleKeyDown"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NewLessonButton" Content="Новый" FontSize="12" Padding="9,6" Click="OnNew"/>
          <Button x:Name="LibraryButton" Content="Уроки" FontSize="12" Padding="9,6" Click="OnLibrary"/>
          <Button x:Name="AddImageButton" Content="＋ Карта" FontSize="12" Padding="9,6" Click="OnAddMap"/>
          <Button x:Name="TimelineButton" Content="＋ Лента" FontSize="12" Padding="9,6" Click="OnAddTimeline"/>
          <Button Content="Экспорт ▾" FontSize="12" Padding="9,6" Click="OnExport" ToolTip="PNG текущего вида, кадра или всей доски; все кадры в PDF"/>
          <Button Content="Фон ▾" FontSize="12" Padding="9,6" Click="OnPaper" ToolTip="Клетка, точки, линейка и однотонный лист"/>
          <Button x:Name="SaveButton" Content="Сохранить" FontSize="12" Padding="13,6" Background="#58725B" Foreground="White" Click="OnSave" Margin="7,0"/>
          <Button x:Name="PresentButton" Content="▷ Показ" FontSize="12" Padding="12,6" Background="#EDF2E7" Click="OnPresent"/>
          <Button x:Name="SettingsButton" Content="⚙" FontFamily="Segoe UI Symbol" FontSize="18" Padding="8,2" Click="OnSettings" AutomationProperties.Name="Настройки"/>
          <Button x:Name="UpdateButton" Content="↻" FontSize="16" Padding="8,3" Click="OnUpdates" ToolTip="Обновления программы"/>
          <Button x:Name="FullscreenButton" Content="⛶" FontSize="18" Padding="8,2" Click="OnFullscreen"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="PropertyBar" Grid.Row="1" Height="38" Background="#FAFBF8" BorderBrush="#E4E8E0" BorderThickness="0,0,0,1">
      <Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UndoButton" Content="↶" FontSize="20" Padding="8,1" Click="OnUndo" ToolTip="Отменить · Ctrl+Z"/>
          <Button x:Name="RedoButton" Content="↷" FontSize="20" Padding="8,1" Click="OnRedo" ToolTip="Повторить · Ctrl+Y"/>
          <Border Width="1" Height="17" Background="#DFE5D9" Margin="11,0"/>
          <TextBlock x:Name="SizeLabel" Text="Шрифт" VerticalAlignment="Center" FontSize="11" Foreground="#7B827C" Margin="0,0,5,0"/>
          <Button Content="−" Click="OnSizeDown" FontSize="16" Padding="7,1"/>
          <TextBlock x:Name="SizeValue" Text="32" Width="25" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="+" Click="OnSizeUp" FontSize="16" Padding="7,1"/>
          <ComboBox x:Name="FontChoice" SelectedIndex="0" Width="127" FontSize="11" Margin="10,0,5,0" SelectionChanged="OnFontChanged"><ComboBoxItem Content="Без засечек"/><ComboBoxItem Content="С засечками"/></ComboBox>
          <Button x:Name="BoldButton" Content="Ж" FontWeight="Bold" Padding="9,3" Click="OnBold" ToolTip="Полужирный · Ctrl+B"/>
          <Button x:Name="FillButton" Content="◧ Заливка" FontSize="11" Padding="8,3" Margin="4,0,0,0" Visibility="Collapsed" Click="OnFill" ToolTip="Полупрозрачная заливка прямоугольников и овалов"/>
          <Border Width="1" Height="17" Background="#DFE5D9" Margin="10,0"/>
          <StackPanel x:Name="Palette" Orientation="Horizontal" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Действия ▾" FontSize="11" Padding="8,4" Click="OnSelectionActions" ToolTip="Копировать, дублировать, группировать и выделить всё"/>
          <TextBlock x:Name="SelectedLabel" Text="" MaxWidth="150" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8A9581" VerticalAlignment="Center" Margin="4,0,8,0"/>
          <Button x:Name="CropButton" Content="Кадрировать" FontSize="11" Padding="8,4" Visibility="Collapsed" Click="OnCrop" ToolTip="Оставить нужную часть карты"/>
          <Button x:Name="RotateButton" Content="Повернуть ↻" FontSize="11" Padding="8,4" Visibility="Collapsed" Click="OnRotate" ToolTip="Повернуть карту на 90° по часовой стрелке"/>
          <Button x:Name="BackButton" Content="На фон" FontSize="11" Padding="8,4" Visibility="Collapsed" Click="OnSendBack"/>
          <Button x:Name="LockButton" Content="Закрепить" FontSize="11" Padding="8,4" IsEnabled="False" Click="OnLock" ToolTip="Защитить объект от перемещения и удаления · Ctrl+L"/>
          <Button x:Name="DeleteButton" Content="Удалить" FontSize="11" Foreground="#8A9581" Padding="8,4" Click="OnDelete"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ToolColumn" Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="ToolRail" Background="#FAFBF8" BorderBrush="#E4E8E0" BorderThickness="0,0,1,0">
        <DockPanel Margin="4,9,4,7"><Button DockPanel.Dock="Bottom" Content="?" FontSize="17" Padding="5,4" Foreground="#7B827C" Click="OnHelp" ToolTip="Помощь"/><StackPanel x:Name="Tools"/></DockPanel>
      </Border>
      <Grid x:Name="Viewport" Grid.Column="1" Background="#FAF7EF" ClipToBounds="True" SizeChanged="OnViewportChanged" PreviewMouseWheel="OnWheel" TouchDown="OnViewportTouchDown" TouchMove="OnViewportTouchMove" TouchUp="OnViewportTouchUp" LostTouchCapture="OnViewportLostTouchCapture" Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False" Stylus.IsTapFeedbackEnabled="False">
        <local:BoardSurface x:Name="Surface" PreviewMouseDown="OnSurfaceMouseDown" PreviewMouseUp="OnSurfaceMouseUp" PreviewMouseMove="OnSurfacePreviewMove" MouseLeftButtonDown="OnBoardDown" MouseMove="OnBoardMove" MouseLeftButtonUp="OnBoardUp" LostMouseCapture="OnLostCapture"/>
        <local:PresentationOverlay x:Name="Overlay" IsHitTestVisible="False" Visibility="Collapsed"/>
        <StackPanel x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
          <TextBlock Text="Место для большой истории" FontSize="25" FontWeight="SemiBold" Foreground="#7C8C70" HorizontalAlignment="Center"/>
          <TextBlock Text="Кликните и пишите. Добавьте карту. Продолжайте в любую сторону." FontSize="13" Foreground="#A0AA98" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="ПРОБЕЛ + МЫШЬ — ДВИГАТЬ ДОСКУ     ·     CTRL + КОЛЁСИКО — МАСШТАБ" FontSize="10" Foreground="#ABB3A4" HorizontalAlignment="Center" Margin="0,24,0,0"/>
        </StackPanel>
        <Canvas x:Name="EditLayer" IsHitTestVisible="False">
          <TextBox x:Name="Editor" Visibility="Collapsed" IsHitTestVisible="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" BorderThickness="1" BorderBrush="#9BAF94" Background="#FAFFFFFF" Padding="0" VerticalScrollBarVisibility="Hidden" TextChanged="OnEditorTextChanged" LostKeyboardFocus="OnEditorLostFocus" PreviewKeyDown="OnEditorKeyDown"/>
        </Canvas>
        <Border x:Name="ZoomControls" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#F9FDFEFB" BorderBrush="#E1E7DA" BorderThickness="1" CornerRadius="7" Margin="0,0,14,14" Padding="2">
          <StackPanel Orientation="Horizontal"><Button Content="−" FontSize="17" Padding="8,1" Click="OnZoomOut"/><Button x:Name="ZoomResetButton" Padding="0,2" Click="OnZoomReset" ToolTip="Вернуть обычный масштаб 100% · Ctrl+1"><TextBlock x:Name="ZoomValue" Text="100%" Width="44" TextAlignment="Center" FontSize="11"/></Button><Button Content="+" FontSize="17" Padding="8,1" Click="OnZoomIn"/><Border Width="1" Height="15" Background="#E1E7DA" Margin="5,0"/><Button x:Name="FitButton" Content="Всё" FontSize="11" Click="OnFit" Padding="10,4"/></StackPanel>
        </Border>
        <Border x:Name="PresentationControls" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#F5FFFFFF" BorderBrush="#DFE5D9" BorderThickness="1" CornerRadius="9" Margin="0,0,0,14" Padding="5,3">
          <StackPanel Orientation="Horizontal"><Button Content="←" FontSize="19" Padding="12,3" Click="OnPreviousFrame"/><TextBlock x:Name="PresentationLabel" Text="1 / 1" MinWidth="160" MaxWidth="350" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/><Button Content="→" FontSize="19" Padding="12,3" Click="OnNextFrame"/><Border Width="1" Height="19" Background="#DFE5D9" Margin="8,0"/><Border Width="1" Height="19" Background="#DFE5D9" Margin="8,0"/><Button x:Name="PointerButton" Content="● Указка" Padding="9,6" FontSize="11" Click="OnPointerTool"/><Button x:Name="SpotlightButton" Content="◎ Прожектор" Padding="9,6" FontSize="11" Click="OnSpotlightTool"/><Button x:Name="CurtainButton" Content="▤ Шторка" Padding="9,6" FontSize="11" Click="OnCurtainTool"/><Border Width="1" Height="19" Background="#DFE5D9" Margin="8,0"/><Button Content="Завершить · Esc" Padding="10,6" FontSize="11" Click="OnEndPresentation"/></StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="FramesTray" Grid.Row="3" Height="48" Background="#F8FAF5" BorderBrush="#E1E7DA" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateFrameButton" Content="↻ Обновить кадр" FontSize="11" Padding="9,4" Margin="0,0,10,0" Visibility="Collapsed" Click="OnUpdateFrame"/>
          <Button x:Name="PreviousFrameButton" Content="←" Padding="9,3" Click="OnPreviousFrame"/><TextBlock x:Name="FrameCounter" Text="0 кадров" FontSize="10" Foreground="#8A9581" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center"/><Button x:Name="NextFrameButton" Content="→" Padding="9,3" Click="OnNextFrame"/>
          <Button x:Name="TrayPresentButton" Content="▷ Показ" FontSize="11" Padding="10,4" Margin="8,0,0,0" Background="#EDF2E7" Click="OnPresent" ToolTip="Показ кадров по порядку · F5"/>
        </StackPanel>
        <Button x:Name="AddFrameButton" DockPanel.Dock="Left" Content="＋ Кадр" Padding="12,6" FontSize="12" Click="OnAddFrame" VerticalAlignment="Center" Background="#E8EFDF" Margin="0,0,12,0"/>
        <ScrollViewer x:Name="FramesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="FrameHint" Text="Кадр — это слайд: сохранённый вид доски. Наведите вид на нужный материал и нажмите «＋ Кадр». В показе (F5) стрелка → переходит от кадра к кадру." FontSize="11" Foreground="#8A9581" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620"/><StackPanel x:Name="FrameButtons" Orientation="Horizontal" VerticalAlignment="Center"/></StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <Border x:Name="StatusBar" Grid.Row="4" Height="24" Background="#FCFDFB" BorderBrush="#E8ECE3" BorderThickness="0,1,0,0">
      <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="● Готово к уроку" VerticalAlignment="Center" Foreground="#7D8A75" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>
        <TextBlock x:Name="ToolHelp" Grid.Column="1" Text="Пробел + мышь — перемещение" MaxWidth="540" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="10" Foreground="#A0AA98" Margin="0,0,20,0"/>
        <TextBlock x:Name="PositionLabel" Grid.Column="2" Text="Бесконечная доска" VerticalAlignment="Center" FontSize="10" Foreground="#A0AA98"/>
      </Grid>
    </Border>
  </Grid>
</Window>
